
import React, { useState } from 'react';
import {
    View,
    StyleSheet,
    StatusBar,
} from 'react-native';

import { Stack, Tabs } from 'expo-router';

import {
    House,
    Activity,
    BrainCircuit,
    Users,
    History,
} from 'lucide-react-native';

import { MissionHealthProvider } from '../context/MissionHealthContext';
import WelcomeScreen from './welcome';

const COLORS = {
    background: '#050B19',
    cyan: '#69E9F7',
    muted: '#7E92AF',
};

function MainTabs() {
    return (
        <Tabs
            screenOptions={{
                headerShown: false,
                tabBarActiveTintColor: COLORS.cyan,
                tabBarInactiveTintColor: COLORS.muted,
                tabBarStyle: {
                    backgroundColor: COLORS.background,
                    borderTopColor: '#1C304A',
                    height: 82,
                    paddingTop: 10,
                    paddingBottom: 22,
                },
                tabBarLabelStyle: {
                    fontSize: 10,
                    fontWeight: '700',
                },
            }}
        >
            <Tabs.Screen
                name="index"
                options={{
                    title: 'Home',
                    tabBarIcon: ({ color, size }) => (
                        <House color={color} size={size} />
                    ),
                }}
            />

            <Tabs.Screen
                name="vitals"
                options={{
                    title: 'Vitals',
                    tabBarIcon: ({ color, size }) => (
                        <Activity color={color} size={size} />
                    ),
                }}
            />

            <Tabs.Screen
                name="aicare"
                options={{
                    title: 'AI Care',
                    tabBarIcon: ({ color, size }) => (
                        <BrainCircuit color={color} size={size} />
                    ),
                }}
            />

            <Tabs.Screen
                name="crew"
                options={{
                    title: 'Crew',
                    tabBarIcon: ({ color, size }) => (
                        <Users color={color} size={size} />
                    ),
                }}
            />

            <Tabs.Screen
                name="history"
                options={{
                    title: 'History',
                    tabBarIcon: ({ color, size }) => (
                        <History color={color} size={size} />
                    ),
                }}
            />

            <Tabs.Screen name="welcome" options={{ href: null }} />
            <Tabs.Screen name="dashboard" options={{ href: null }} />
            <Tabs.Screen name="alerts" options={{ href: null }} />
            <Tabs.Screen name="analysis" options={{ href: null }} />
            <Tabs.Screen name="missionoverview" options={{ href: null }} />
            <Tabs.Screen name="missionevents" options={{ href: null }} />
            <Tabs.Screen name="missionreport" options={{ href: null }} />
            <Tabs.Screen name="missionreadiness" options={{ href: null }} />
            <Tabs.Screen name="missionintelligence" options={{ href: null }} />
            <Tabs.Screen name="explore" options={{ href: null }} />
        </Tabs>
    );
}

export default function RootLayout() {
    const [showWelcome, setShowWelcome] = useState(true);

    return (
        <MissionHealthProvider>
            <View style={styles.container}>
                <StatusBar barStyle="light-content" />

                <MainTabs />

                {showWelcome && (
                    <View style={styles.welcomeOverlay}>
                        <WelcomeScreen
                            onEnter={() => setShowWelcome(false)}
                        />
                    </View>
                )}
            </View>
        </MissionHealthProvider>
    );
}

const styles = StyleSheet.create({
    container: {
        flex: 1,
        backgroundColor: '#050B19',
    },
    welcomeOverlay: {
        position: 'absolute',
        top: 0,
        left: 0,
        right: 0,
        bottom: 0,
        backgroundColor: '#050B19',
        zIndex: 999,
        elevation: 999,
    },
});
